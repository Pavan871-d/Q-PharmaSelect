# ==============================================================================
# Q-PharmaSelect Environment Variables & Secret Configuration
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Database Configuration
DATABASE_URL=sqlite:///./qpharmaselect.db

# QpiAI Technologies Credentials
# Obtain QCloud key from: https://qcloud.qpiai.tech
QPIAI_QCLOUD_API_KEY=your_qpiai_qcloud_api_key_here

# Obtain QpiAI Opt token from: https://opt.qpiai.tech
QPIAI_OPT_API_KEY=your_qpiai_opt_api_key_here
QPIAI_OPT_URL=https://opt.qpiai.tech

# Server Network Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173

